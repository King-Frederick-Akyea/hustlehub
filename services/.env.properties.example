# Copy this file to .env.properties (already gitignored) and fill in real values.
# Every service imports this one file (see "spring.config.import" in each service's
# application.properties), so these four values only need to be set in one place instead of
# copy-pasted into six per-service application-dev.properties files.
#
# Values that are genuinely specific to a single service (Brevo email key for identity-service,
# Paystack key for payments-service) still live in that service's own application-dev.properties,
# not here - see application-dev.properties.example in those two service directories.

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-postgres-password

# Generate one with: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# Must be identical across every service - they all validate the same tokens identity-service issues.
JWT_SECRET=replace-with-a-base64-random-32-plus-byte-secret

# Shared secret every service must send as X-Internal-Key when calling another service's /internal/** routes.
# Must be identical across every service.
INTERNAL_API_KEY=replace-with-a-shared-internal-api-key

# Single hardcoded admin login for the hustlehubwebsite admin panel (see identity-service's
# AdminAuthController - no admin_users table, just these two values). Only identity-service
# reads these; the other five business services never need them.
ADMIN_USERNAME=replace-with-an-admin-username
ADMIN_PASSWORD=replace-with-a-strong-admin-password

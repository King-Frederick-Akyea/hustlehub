<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.hustlehub</groupId>
	<artifactId>hustlehub-services</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>hustlehub-services</name>
	<description>HustleHub backend microservices reactor</description>

	<!--
	 This is a build-convenience aggregator only (`mvn clean install` here builds everything in
	 dependency order). It is NOT a Spring Boot parent — each service keeps its own
	 spring-boot-starter-parent so it stays independently buildable/deployable from its own
	 directory without needing this file at all (`cd identity-service && ./mvnw spring-boot:run`
	 works with zero knowledge of the reactor).
	-->
	<modules>
		<module>common</module>
		<module>gateway-service</module>
		<module>identity-service</module>
		<module>tasks-service</module>
		<module>messaging-service</module>
		<module>notifications-service</module>
		<module>payments-service</module>
		<module>rentals-service</module>
		<module>reviews-service</module>
	</modules>

	<properties>
		<java.version>17</java.version>
		<maven.compiler.source>17</maven.compiler.source>
		<maven.compiler.target>17</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>
</project>

# Copy this file to application-dev.properties (already gitignored) and fill in real values.
# application-dev.properties is loaded automatically because application.properties defaults
# spring.profiles.active to "dev".
#
# DB password / JWT secret / internal API key are NOT set here - they come from the one shared
# services/.env.properties every service imports (see services/.env.properties.example). This file
# only holds what's genuinely specific to identity-service: outgoing email.

app.mail.dev-echo-enabled=true

# "logging" (default, safe) just logs codes to the console instead of emailing them - fine to leave
# this whole block out entirely if you don't need real email delivery locally.
app.mail.provider=brevo

# Brevo transactional email HTTP API - from Brevo dashboard: Settings -> SMTP & API -> API Keys tab.
app.mail.brevo.api-key=replace-with-your-brevo-api-key
app.mail.from-address=replace-with-a-verified-brevo-sender@example.com
app.mail.from-name=HustleHub

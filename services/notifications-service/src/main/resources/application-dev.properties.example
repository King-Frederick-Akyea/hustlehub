# Copy this file to application-dev.properties (already gitignored) and fill in real values.
# application-dev.properties is loaded automatically because application.properties defaults
# spring.profiles.active to "dev".

spring.datasource.url=jdbc:postgresql://localhost:5432/hustlehub_notifications
spring.datasource.username=postgres
spring.datasource.password=replace-with-your-postgres-password

# Must match the secret used by every other service in the reactor (identity-service issues
# the tokens; every other service only validates them) - generate one with:
# [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
app.jwt.secret=replace-with-a-base64-random-32-plus-byte-secret

spring.jpa.show-sql=false
logging.level.com.hustlehub.notifications=DEBUG
